# 导演模型提供方：openai、openrouter 或 claude_converse
DIRECTOR_PROVIDER=openrouter

# OpenAI Responses API 配置
OPENAI_API_KEY=sk-your-key
OPENAI_DIRECTOR_MODEL=your-structured-output-capable-model
OPENAI_MAX_OUTPUT_TOKENS=60000

# OpenRouter Chat Completions 配置。密钥只放 .env，不要提交到 Git。
OPENROUTER_API_KEY=sk-or-v1-your-new-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DIRECTOR_MODEL=anthropic/claude-opus-5
OPENROUTER_MAX_OUTPUT_TOKENS=110000
OPENROUTER_REASONING_EFFORT=medium

# 站位图真实生成：按钮点击后调用 OpenRouter Images API，会产生图片模型费用。
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_IMAGE_RESOLUTION=1K
OPENROUTER_IMAGE_QUALITY=medium

# 星图 5.0 Pro / 火山方舟文生图。密钥只放本地 .env，不要提交到 Git。
XINGTU_IMAGE_API_KEY=ark-your-new-key
XINGTU_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
XINGTU_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
XINGTU_IMAGE_SIZE=2K

# 自定义 Claude Converse 网关配置。密钥只放 .env，不要提交到 Git。
# DIRECTOR_PROVIDER=claude_converse
# CLAUDE_CONVERSE_URL=https://your-gateway.example/v1/claude/converse
# Optional outbound HTTP/HTTPS proxy, used only when the page selects proxy mode.
# Example: http://127.0.0.1:7890
# CLAUDE_HTTP_PROXY_URL=
# CLAUDE_REGION=us-west-2
# CLAUDE_CONVERSE_API_KEY=sk-your-key
# CLAUDE_DIRECTOR_MODEL=global.anthropic.claude-opus-5
# CLAUDE_MAX_OUTPUT_TOKENS=128000
# CLAUDE_THINKING_EFFORT=medium
# CLAUDE_CONVERSE_TIMEOUT_SECONDS=300

PIPELINE_TIMEOUT_SECONDS=300
# PIPELINE_ROOT=D:/service/pipeline_runtime
# PIPELINE_WORK_ROOT=D:/service/var/jobs
