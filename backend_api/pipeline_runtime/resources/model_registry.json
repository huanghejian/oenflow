{
  "routing_policy": {
    "price_version": "2026-08-25_points_report_v1",
    "tier_model_allowlist": {
      "low": [
        "higgsfield-h3",
        "seedance-2.0",
        "seedance-2.5",
        "wan-3.0"
      ],
      "medium": [
        "higgsfield-h3",
        "seedance-2.0",
        "seedance-2.5",
        "wan-3.0"
      ],
      "high": [
        "higgsfield-h3",
        "seedance-2.0",
        "seedance-2.5",
        "wan-3.0"
      ]
    },
    "tier_quality_floor": {
      "low": 76.0,
      "medium": 82.0,
      "high": 88.0
    },
    "tier_weights": {
      "low": {
        "quality": 0.1,
        "reliability": 0.1,
        "cost_efficiency": 0.8
      },
      "medium": {
        "quality": 0.45,
        "reliability": 0.25,
        "cost_efficiency": 0.3
      },
      "high": {
        "quality": 0.85,
        "reliability": 0.15,
        "cost_efficiency": 0.0
      }
    },
    "low_near_cost_ratio": 1.03,
    "quality_score_min": 0.0,
    "quality_score_max": 100.0,
    "high_quality_gain_threshold": 2.5,
    "high_near_quality_strategy": "lowest_expected_usable_points",
    "partition_optimizer": {
      "enabled": true,
      "prefer_fewer_calls_when_expected_points_within": 0.5,
      "max_atomic_segments_per_block": 40
    },
    "tier_strategy": {
      "low": {
        "objective": "min_expected_usable_points_above_quality_floor",
        "description": "达到最低交付质量后，优先预计可用积分最低；允许任意模型和preset，只要能力与质量门槛合格。"
      },
      "medium": {
        "objective": "minimum_sufficient_expected_usable_points",
        "description": "Minimum Sufficient：先达到当前镜头的中档目标质量与最低首轮可用率，再在满足目标的候选中选择预计可用积分最低者；pro仅当没有非pro候选达到目标时使用。"
      },
      "high": {
        "objective": "near_best_quality_with_cost_guardrail",
        "description": "重要镜头追求接近最佳质量；简单镜头允许H3/S2.0/Wan等候选，只要与最佳质量差不超过阈值且更稳或明显更省。"
      }
    },
    "sr_hard_policy": {
      "enabled": true,
      "allowed_shot_size_categories": [
        "特写",
        "大特写"
      ],
      "require_all_atomic_segments_match": true,
      "reject_mixed_shot_size_segment": true,
      "description": "所有名称含SR的preset仅允许全段特写/大特写。近景、中近景、中景、全景、远景及“近景→特写”等混合景别一票否决。手部/眼部/道具特写按“特写”类别处理。"
    },
    "medium_value_policy": {
      "enabled": false,
      "value_model_ids": [
        "higgsfield-h3",
        "wan-3.0"
      ],
      "value_preset_tokens": [
        "mini",
        "fast",
        "SR",
        "补贴版"
      ],
      "pro_preset_tokens": [
        "pro"
      ],
      "max_tier_score_loss_for_value": 3.0,
      "pro_min_quality_gain_over_best_value": 6.5,
      "pro_min_reliability_gain_over_best_value": 0.06,
      "description": "V6已由medium_minimum_sufficient_policy取代，保留仅用于旧配置兼容。"
    },
    "medium_minimum_sufficient_policy": {
      "enabled": true,
      "quality_target_by_story_priority": {
        "normal": 86.0,
        "key": 89.0,
        "climax": 92.0
      },
      "reliability_floor_by_story_priority": {
        "normal": 0.78,
        "key": 0.82,
        "climax": 0.85
      },
      "critical_requirement_quality_boost": 0.5,
      "max_critical_quality_boost": 1.5,
      "pro_last_resort": true,
      "pro_preset_tokens": [
        "pro"
      ],
      "near_cost_ratio": 1.02,
      "fallback_when_target_unmet": "best_available_quality_then_reliability_then_points",
      "description": "中档不是综合分最高，而是刚好满足目标品质的最低预计可用积分。关键/高潮镜头目标更高；如存在非pro候选达到目标，pro直接退出最终竞争。"
    },
    "preset_quality_observations": {
      "seedance_closeup_ordering": [
        "SR",
        "fast",
        "mini"
      ],
      "applies_when": [
        "特写",
        "大特写"
      ],
      "note": "这是实测先验，只通过shot_quality_profiles影响质量分；SR仍必须先通过全段特写/大特写硬门槛。"
    },
    "logical_material_input_policy": {
      "enabled": true,
      "hard_filter_before_quality_and_price": true,
      "partition_on_reference_overflow": true,
      "description": "逻辑素材类型、用途、数量和总文件上限先于质量/价格裁决；不要求真实URL/file_id。超限候选直接invalid，允许在原子自然边界重新分区。"
    },
    "logical_reference_binding_stage": "prompt_and_routing_use_asset_id_only; real file binding happens in video executor"
  },
